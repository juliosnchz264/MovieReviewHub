# Postgres URI for node-postgres. NOT the jdbc:postgresql:// form used in backend/.env.
#
# Local docker-compose:
#   DATABASE_URL=postgres://postgres:postgres@localhost:5432/moviereviewhub
#
# Supabase pooler (port 6543, transaction mode — works fine for this script):
#   DATABASE_URL=postgres://postgres.<project-ref>:<password>@aws-0-eu-west-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Optional. Deterministic runs.
SEED=20260513

# Optional. Set to 1 to plan but skip all writes.
DRY_RUN=0
